SIM = icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../rtl/operand_bank.sv ../rtl/operand_buffer.sv ../rtl/pe.sv ../rtl/systolic_array.sv ../rtl/buffered_array.sv
COCOTB_TOPLEVEL = buffered_array
COCOTB_TEST_MODULES = test_buffered_array
SIM_BUILD = sim_build/buffered_array_4x4
COMPILE_ARGS += -Pbuffered_array.ROWS=4 -Pbuffered_array.COLS=4 -Pbuffered_array.DEPTH=16
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps
include $(shell cocotb-config --makefiles)/Makefile.sim
