SIM = icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../rtl/pe.sv ../rtl/systolic_array.sv
COCOTB_TOPLEVEL = systolic_array
COCOTB_TEST_MODULES = test_array_reference
SIM_BUILD = sim_build/array_4x4
COMPILE_ARGS += -Psystolic_array.ROWS=4 -Psystolic_array.COLS=4
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps
include $(shell cocotb-config --makefiles)/Makefile.sim
