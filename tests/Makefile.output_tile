SIM = icarus
TOPLEVEL_LANG = verilog
ROWS ?= 4
COLS ?= 4
DIM_WIDTH ?= 16
export TEST_ROWS = $(ROWS)
export TEST_COLS = $(COLS)
VERILOG_SOURCES = ../rtl/output_tile_controller.sv
COCOTB_TOPLEVEL = output_tile_controller
COCOTB_TEST_MODULES = test_output_tile_controller
SIM_BUILD = sim_build/output_tile_$(ROWS)x$(COLS)_d$(DIM_WIDTH)
COMPILE_ARGS += -Poutput_tile_controller.ROWS=$(ROWS) -Poutput_tile_controller.COLS=$(COLS) -Poutput_tile_controller.DIM_WIDTH=$(DIM_WIDTH)
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps
include $(shell cocotb-config --makefiles)/Makefile.sim
