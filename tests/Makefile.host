SIM = icarus
TOPLEVEL_LANG = verilog
ROWS ?= 4
COLS ?= 4
DEPTH ?= 16
DOUBLE_BUFFER ?= 0
export TEST_ROWS = $(ROWS)
export TEST_COLS = $(COLS)
export TEST_DEPTH = $(DEPTH)
export TEST_DOUBLE_BUFFER = $(DOUBLE_BUFFER)
VERILOG_SOURCES = ../rtl/double_buffer_controller.sv ../rtl/double_buffered_tile_engine.sv ../rtl/operand_bank.sv ../rtl/operand_buffer.sv ../rtl/pe.sv ../rtl/systolic_array.sv ../rtl/buffered_array.sv ../rtl/read_scheduler.sv ../rtl/tile_engine.sv ../rtl/chunk_controller.sv ../rtl/chunked_tile_engine.sv ../rtl/output_tile_controller.sv ../rtl/tiled_matmul.sv ../rtl/matmul_host.sv
COCOTB_TOPLEVEL = matmul_host
COCOTB_TEST_MODULES = test_matmul_host
SIM_BUILD = sim_build/matmul_host_$(ROWS)x$(COLS)_depth$(DEPTH)_db$(DOUBLE_BUFFER)
COMPILE_ARGS += -Pmatmul_host.DOUBLE_BUFFER=$(DOUBLE_BUFFER) -Pmatmul_host.ROWS=$(ROWS) -Pmatmul_host.COLS=$(COLS) -Pmatmul_host.DEPTH=$(DEPTH)
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps
include $(shell cocotb-config --makefiles)/Makefile.sim
