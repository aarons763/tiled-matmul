SIM = icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../rtl/operand_bank.sv
COCOTB_TOPLEVEL = operand_bank
COCOTB_TEST_MODULES = test_operand_bank
SIM_BUILD = sim_build/operand_bank_16
COMPILE_ARGS += -Poperand_bank.DEPTH=16
COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps
include $(shell cocotb-config --makefiles)/Makefile.sim
